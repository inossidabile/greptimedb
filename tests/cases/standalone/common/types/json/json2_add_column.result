-- Invalid JSON2 settings are rejected without changing the table.
ALTER TABLE json2_add_column ADD COLUMN bad JSON2 (a STRING, a BIGINT);

Error: 2000(InvalidSyntax), Invalid SQL syntax: sql parser error: Invalid SQL, error: duplicated JSON2 type hint path 'a'

ALTER TABLE json2_add_column ADD COLUMN bad JSON2 (a INT8);

Error: 2000(InvalidSyntax), Invalid SQL syntax: sql parser error: Invalid SQL, error: unsupported JSON2 type hint data type: INT8; supported types: STRING, BIGINT, BIGINT UNSIGNED, DOUBLE, BOOLEAN; supported aliases: INT64, UINT64, FLOAT64

-- Plain columns still go through the usual path, also mixed with JSON2 ones.
ALTER TABLE json2_add_column
    ADD COLUMN zone STRING DEFAULT 'z1' COMMENT 'zone' FIRST,
    ADD COLUMN extra JSON2 (k STRING) AFTER host;

Affected Rows: 0

DESC TABLE json2_add_column;

+-----------+----------------------+-----+------+---------+---------------+
| Column    | Type                 | Key | Null | Default | Semantic Type |
+-----------+----------------------+-----+------+---------+---------------+
| zone      | String               |     | YES  | z1      | FIELD         |
| ts        | TimestampMillisecond | PRI | NO   |         | TIMESTAMP     |
| host      | String               | PRI | YES  |         | TAG           |
| extra     | Json2                |     | YES  |         | FIELD         |
| trace_ctx | Json2                |     | YES  |         | FIELD         |
| attrs     | Json2                |     | YES  |         | FIELD         |
| baggage   | Json2                |     | YES  |         | FIELD         |
+-----------+----------------------+-----+------+---------+---------------+

